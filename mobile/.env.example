# API base URL. Keep the /api suffix; the app appends /v1 for application endpoints.
# This value is embedded in the mobile build, so use an HTTPS production API URL for store builds.
EXPO_PUBLIC_API_URL=https://api.example.com/api

# Local web or simulator on the same computer:
# EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Android Emulator with backend on the host computer:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# Physical phone or another computer on the same LAN:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api
